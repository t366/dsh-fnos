#!/bin/bash
# upgrade_init — 解包前执行（这是唯一能干净清理旧文件的窗口）。
#
# 关键：覆盖安装通常只是叠文件、不清旧文件。不先移走 runtime，新旧版本会混在一起。
# 这里用「改名而非删除」，万一新包解包失败还能在 upgrade_callback 里恢复。

set -u

CMD_DIR="$(cd "$(dirname "$0")" 2>/dev/null && pwd)"
PKGVAR="${TRIM_PKGVAR:-/tmp}"
APPDEST="${TRIM_APPDEST:-}"
LOGFILE="$PKGVAR/info.log"
ERRFILE="${TRIM_TEMP_LOGFILE:-}"

log() { printf '%s [%s] upgrade_init: %s\n' "$(date '+%F %T')" "$$" "$*" >>"$LOGFILE" 2>/dev/null; }
fail() {
  log "FAIL: $*"
  [ -n "$ERRFILE" ] && printf '%s\n' "$*" >"$ERRFILE" 2>/dev/null
  exit 1
}

# 快照阶段出事时，应用已经被上面 stop 掉了。直接 exit 会让用户对着「已停止」
# 猜原因，所以先按**旧运行时**把它拉回来再报错 —— 这一步失败不改变升级中止的结论。
abort_upgrade() { # $1=原因
  log "FAIL: $1"
  if "$CMD_DIR/main" start >>"$LOGFILE" 2>&1; then
    log "回滚: 已按原版本重新启动（数据未改动）"
  else
    log "WARN: 快照失败后自动回启也失败，请在应用中心手动启动"
  fi
  [ -n "$ERRFILE" ] && printf '%s\n' "$1" >"$ERRFILE" 2>/dev/null
  exit 1
}

log "begin (${TRIM_OLD_APPVER:-?} -> ${TRIM_APPVER:-?})"

# ---- 1. 防御性停机（不假设系统已经帮我们停了）----
"$CMD_DIR/main" stop >>"$LOGFILE" 2>&1

# ---- 2. 数据快照 ----
# 必须在 stop 之后：会话是 SQLite，带 -wal 的时候打包只能拿到半份状态。
# 路径不能写死 $PKGVAR/dsh-home —— 0.2.0 起数据在「共享目录/.dsh-home」，
# 写死旧路径的后果是整段被 `[ -d ]` 静默跳过：0.6.1→0.7.1 共 7 次升级，
# info.log 里 backup 出现 0 次（2026-11-01 复盘，见 ISSUES F31）。
. "$CMD_DIR/lib-home" || fail "安装包不完整：缺少 cmd/lib-home，无法定位数据目录。"
DSH_HOME="$(dsh_home_for "$PKGVAR")"
BACKUP_DIR="$(dsh_backup_dir_for "$PKGVAR")"
LEGACY_BACKUP_DIR="$PKGVAR/backups"

# 0.7.2 及以前快照写在 @appdata，而卸载会清空那里（F35）。这里先把旧快照搬到
# 新落点：同卷 mv 只是改名，不占额外空间，也不会因为漏搬而在用户回滚时才发现丢了。
if [ "$BACKUP_DIR" != "$LEGACY_BACKUP_DIR" ] && [ -d "$LEGACY_BACKUP_DIR" ]; then
  mkdir -p "$BACKUP_DIR" 2>/dev/null
  for _old in "$LEGACY_BACKUP_DIR"/pre-upgrade-*.tar.gz; do
    [ -f "$_old" ] || continue
    if [ -e "$BACKUP_DIR/$(basename "$_old")" ]; then
      rm -f "$_old" 2>/dev/null
      log "backup: 旧快照已在新位置，删除重复 $(basename "$_old")"
    elif mv "$_old" "$BACKUP_DIR/" 2>/dev/null; then
      log "backup: 迁移旧快照 $(basename "$_old") → $BACKUP_DIR"
    else
      log "WARN: 无法迁移旧快照 $_old（将留在原地，卸载时可能丢失）"
    fi
  done
  rmdir "$LEGACY_BACKUP_DIR" 2>/dev/null || true
fi

log "backup-dir: $BACKUP_DIR（数据目录 $DSH_HOME）"

if [ -d "$DSH_HOME" ]; then
  mkdir -p "$BACKUP_DIR" 2>/dev/null \
    || abort_upgrade "无法创建快照目录 $BACKUP_DIR（磁盘满或权限不足），升级已中止。"

  # 包名带 .dsh-home 这一层：恢复时直接 `tar -xzf … -C <共享目录>` 即可，
  # 不需要记「当时解到哪」。
  PARENT="$(dirname "$DSH_HOME")"
  LEAF="$(basename "$DSH_HOME")"
  BACKUP="$BACKUP_DIR/pre-upgrade-${TRIM_OLD_APPVER:-unknown}-to-${TRIM_APPVER:-unknown}-$(date +%Y%m%d-%H%M%S).tar.gz"

  tar -czf "$BACKUP" -C "$PARENT" "$LEAF" >>"$LOGFILE" 2>&1
  TARC=$?
  if [ "$TARC" -eq 0 ]; then
    log "backup: ok $BACKUP ($(du -sh "$BACKUP" 2>/dev/null | awk '{print $1}'))"
  elif [ "$TARC" -eq 1 ] && [ -s "$BACKUP" ]; then
    # GNU tar 的 1 = 打包过程中有文件变化，包仍然可用。停机之后理论上不该出现，
    # 但为了不因为一个临时文件把升级卡死，按 WARN 放行并留痕。
    log "WARN: 快照有文件在打包期间变化（tar rc=1），继续：$BACKUP"
  else
    # 2 及以上是真失败（磁盘满 / 权限 / 路径不存在）。继续下去是
    # 「升级成功但回不了头」，比不升级更糟，所以硬停。
    rm -f "$BACKUP" 2>/dev/null
    abort_upgrade "升级前快照失败（$DSH_HOME → $BACKUP_DIR，tar rc=$TARC）：磁盘空间或权限不足。升级已中止，数据未改动。"
  fi

  # 只留最近 2 份。每份是整份会话+插件（profiles 里可能有 node_modules），
  # 不轮转的话升几次就把共享目录吃掉一块。
  ls -1t "$BACKUP_DIR"/pre-upgrade-*.tar.gz 2>/dev/null | tail -n +3 | while IFS= read -r old; do
    [ -f "$old" ] || continue
    if rm -f "$old" 2>/dev/null; then
      log "backup: 清理旧快照 $(basename "$old")"
    else
      log "WARN: 无法清理旧快照 $old"
    fi
  done
else
  # 目录不存在也要留痕：写错路径时必须看得出来，而不是像以前那样静默空转。
  log "backup: 跳过——$DSH_HOME 不存在（首次安装，或数据目录尚未建立）"
fi

# ---- 3. 移走旧运行时 ----
RUNTIME="$APPDEST/runtime"
if [ -d "$RUNTIME" ]; then
  rm -rf "$RUNTIME.old" 2>/dev/null
  mv "$RUNTIME" "$RUNTIME.old" 2>/dev/null || fail "无法移走旧运行时，升级中止以避免新旧文件混杂。"
  log "runtime: moved to $RUNTIME.old"
fi

# ---- 4. 记录升级前状态（供 upgrade_callback 与 doctor 使用）----
{
  printf 'FROM=%s\n' "${TRIM_OLD_APPVER:-unknown}"
  printf 'TO=%s\n' "${TRIM_APPVER:-unknown}"
  printf 'AT=%s\n' "$(date '+%F %T')"
  printf 'DSH_HOME=%s\n' "$DSH_HOME"
  printf 'BACKUP=%s\n' "${BACKUP:-}"
} >"$PKGVAR/upgrade-state.conf" 2>/dev/null

log "ok"
exit 0
