#!/bin/bash
# ============================================================================
# dsh on fnOS — 生命周期主脚本（cmd/main）
#
# 契约：main start|stop|status
#   退出码 0 = 成功 / status 表示运行中
#          1 = 失败
#          3 = status 表示未运行
#
# 设计要点（都由真机实测得出，改动前先读 PLAN.md §2.3 / §4.2）：
#   1. fnOS 没有 systemd 集成，start 必须自己后台化 → 用 setsid 建独立进程组
#   2. dsh 会 fork pty / shell 子进程 → stop 必须整组回收，否则留孤儿
#   3. dsh 拒绝 0.0.0.0 → 必须绑具体网卡地址，且网络可能晚于应用就绪 → 先等地址
#   4. PATH 上的 node 是 v22.19，不满足 dsh 的 >=24.9 → 必须探测绝对路径
#   5. 所有路径从 TRIM_* 派生，不硬编码 /vol1
# ============================================================================

set -u

APPNAME="dsh"
SELF_DIR="$(cd "$(dirname "$0")" 2>/dev/null && pwd)"

# 应用用户（平台通过 TRIM_USERNAME 给出）。我们以 root 运行时，
# 自己创建的文件必须显式交给它，否则 dsh 写不进去。
DSH_USER="${TRIM_USERNAME:-dsh}"

# ---- 路径（一律从 TRIM_* 派生；缺省值只用于本机调试） ----
APPDEST="${TRIM_APPDEST:-$SELF_DIR/../target}"

# PKGVAR 必须对两个入口算出同一个目录。平台调用时 TRIM_PKGVAR 是权威值；
# 手工从 /var/apps/dsh/cmd 跑时它不存在，旧代码会落到 /var/apps/dsh/var ——
# 而应用中心那套用的是 /vol1/@appdata/dsh，于是同一台机器上并存两套
# pidfile / launcher.json，谁也没杀掉谁：2026-10-27 21:13 手工启动的跳转器
# 一直占着 3080，21:31 与 22:07 两次 start 都撞 EADDRINUSE，直到 23:33 才停。
# 现在缺省值按平台布局归一（@appcenter → @appdata），两边指向同一个 var。
if [ -n "${TRIM_PKGVAR:-}" ]; then
  PKGVAR="$TRIM_PKGVAR"
else
  _apd="$(readlink -f "${TRIM_APPDEST:-$SELF_DIR/../target}" 2>/dev/null)"
  case "${_apd:-}" in
    */@appcenter/*) PKGVAR="${_apd%%/@appcenter/*}/@appdata/$APPNAME" ;;
    *) PKGVAR="$SELF_DIR/../var" ;;
  esac
  unset _apd
fi
PKGETC="${TRIM_PKGETC:-$SELF_DIR/../etc}"

RUNTIME="$APPDEST/runtime"

# 让 Web 形态带上 Office 技能的可选覆盖层（详见该文件里的说明）。
# 只在运行期确认三个路径都存在时才传给 dsh，否则完全不用它。
OFFICE_PATCH="$RUNTIME/profile/office.patch.yml"

# dsh-home 放在共享目录里，卸载重装才不丢会话与凭据（实测 @appdata 会被连根删掉）。
# 推导只在 cmd/lib-home 里留一份：以前 main 与 install_callback 各写一遍，
# 升级链路又各自硬编码旧路径，结果快照与凭据检查全在看一个不存在的目录。
. "$SELF_DIR/lib-home" || { echo "安装包不完整：缺少 cmd/lib-home" >&2; exit 1; }
DSH_HOME="$(dsh_home_for "$PKGVAR")"

# dsh 的默认工作区固定在 <系统文档目录>/deepseek-harness/default-workspace（见 F22）。
# 文档目录在 linux 上由 xdg-user-dir 读 $HOME/.config/user-dirs.dirs 得到。
DOCS_FILE="$DSH_HOME/.config/user-dirs.dirs"
DSH_DEFAULT_WS=""

# 组名不一定跟着 TRIM_* 一起传进来。DSH_HOME 已存在时以它的属组为准，
# 免得分给我们新建的目录改成 dsh 组，与平台的 dsh:AppUsers 不一致。
if [ -n "${TRIM_GROUPNAME:-}" ]; then
  DSH_GROUP="$TRIM_GROUPNAME"
else
  DSH_GROUP="$(stat -c '%G' "$DSH_HOME" 2>/dev/null || true)"
  [ -n "${DSH_GROUP:-}" ] || DSH_GROUP="$DSH_USER"
fi

PIDFILE="$PKGVAR/dsh.pid"
LOGFILE="$PKGVAR/info.log"
SETTINGS="$PKGETC/settings.conf"
URLFILE="$PKGVAR/dsh-url.txt"

# 入口跳转器：service_port 归它，dsh 退到 service_port+1。
# 目的：点图标即进 —— 跳转器读本次启动的令牌，直接 302 到带 token 的地址，
# 用户不用再去命令行取令牌。DSH_ENTRY=pair 可退回「粘贴一次令牌」的旧行为。
LAUNCHER_PIDFILE="$PKGVAR/launcher.pid"
LAUNCHER_ENTRY="$RUNTIME/launcher/server.mjs"
# 多网卡入口的 TCP 中继（见 app/runtime/relay/server.mjs 顶部注释）。
# dsh 只能绑一个具体 IP，其余网卡的地址由它接住、原样转发。
RELAY_PIDFILE="$PKGVAR/relay.pid"
RELAY_ENTRY="$RUNTIME/relay/server.mjs"
STATEFILE="$PKGVAR/launcher.json"
INTERNAL_PORT=""
ERRFILE="${TRIM_TEMP_LOGFILE:-}"

DEFAULT_PORT=3080
ADDR_TIMEOUT=60
PORT_TIMEOUT=45
STOP_TIMEOUT=15

mkdir -p "$PKGVAR" 2>/dev/null

# ---------------------------------------------------------------- 工具

log() { printf '%s [%s] %s\n' "$(date '+%F %T')" "$$" "$*" >>"$LOGFILE" 2>/dev/null; }

say() {
  log "ERROR: $*"
  if [ -n "$ERRFILE" ]; then
    printf '%s\n' "$*" >"$ERRFILE" 2>/dev/null
  fi
}

die() { say "$*"; exit 1; }

now() { date +%s; }

is_ipv4() {
  printf '%s' "${1:-}" | grep -qE '^([0-9]{1,3}\.){3}[0-9]{1,3}$' || return 1
  local IFS=. o
  for o in $1; do
    [ "$o" -ge 0 ] 2>/dev/null && [ "$o" -le 255 ] 2>/dev/null || return 1
  done
  return 0
}

ver_ge() { # $1 >= $2 ？（点分比较，不能用字符串比：24.19 < 24.9）
  [ -n "${1:-}" ] || return 1
  [ "$(printf '%s\n%s\n' "$1" "$2" | sort -V | head -n1)" = "$2" ]
}

# ---------------------------------------------------------------- 配置

get_conf() { # $1=key
  [ -f "$SETTINGS" ] || return 1
  grep -E "^$1=" "$SETTINGS" 2>/dev/null | tail -n1 | cut -d= -f2- | tr -d '\r'
}

load_settings() {
  DSH_PORT="$(get_conf DSH_PORT || true)"
  DSH_BIND="$(get_conf DSH_BIND || true)"
  DSH_API_KEY="$(get_conf DSH_API_KEY || true)"
  DSH_ENTRY="$(get_conf DSH_ENTRY || true)"

  [ -n "${DSH_PORT:-}" ] || DSH_PORT="$DEFAULT_PORT"
  [ -n "${DSH_BIND:-}" ] || DSH_BIND="auto"
  case "${DSH_ENTRY:-}" in
    pair|PAIR|Pair) DSH_ENTRY="pair" ;;
    *) DSH_ENTRY="auto" ;;
  esac

  case "$DSH_PORT" in
    ''|*[!0-9]*) DSH_PORT="$DEFAULT_PORT" ;;
  esac
  if [ "$DSH_PORT" -lt 1 ] || [ "$DSH_PORT" -gt 65535 ]; then
    DSH_PORT="$DEFAULT_PORT"
  fi
}

# ---------------------------------------------------------------- 网络

detect_lan_ip() {
  local ip
  ip="$(ip route get 1.1.1.1 2>/dev/null \
        | awk '{for(i=1;i<=NF;i++) if($i=="src"){print $(i+1); exit}}')"
  if [ -z "$ip" ]; then
    ip="$(hostname -I 2>/dev/null | awk '{print $1}')"
  fi
  printf '%s' "$ip"
}

resolve_bind() {
  local want="${1:-auto}"
  case "$want" in
    ""|auto|AUTO) detect_lan_ip ;;
    *) printf '%s' "$want" ;;
  esac
}

# 本机可用于入口的 IPv4（scope global）。
#
# 为什么需要这一步：dsh 的 web 载体只接受「某个具体接口的地址」作为 --host，
# 通配地址在 load 阶段就被拒绝（见 docs/HARNESS-ARCHITECTURE.md §5.1）。
# 而 NAS 常常有两个地址——真机就是 .109（无线）与 .114（OVS 默认路由）——
# 只绑一个的话，从另网段进来的浏览器直接 ECONNREFUSED。
#
# 排除虚拟接口（容器、隧道、虚拟机网桥），但**不排除 `<hash>-ovs`**：
# 飞牛的默认路由往往就挂在这种网桥上（实测 192.168.0.114），排掉它等于
# 把主路径丢了。判断只看接口名前缀，不看地址段——地址段判断会把
# 172.17/16 这种真实局域网误伤。
local_ipv4_addrs() {
  command -v ip >/dev/null 2>&1 || return 0
  ip -4 -o addr show scope global 2>/dev/null \
    | awk '{
        iface = $2
        for (i = 3; i <= NF; i++) {
          if ($i == "inet") {
            split($(i + 1), a, "/")
            if (iface !~ /^(lo|docker|br-|veth|virbr|tun|tap|zt|tailscale|wg)/) print a[1]
          }
        }
      }' \
    | sort -u
}

# 除绑定地址之外、需要接住的地址。
# DSH_EXTRA_IPS（逗号分隔）可显式覆盖：多网卡探测不准、或在容器/虚拟环境里
# 预先指定时用；也用于自测（127.0.0.2 冒充第二张网卡）。
other_ipv4_addrs() { # $1=bind
  local bind="$1" ip
  if [ -n "${DSH_EXTRA_IPS:-}" ]; then
    for ip in ${DSH_EXTRA_IPS//,/ }; do
      [ -n "$ip" ] || continue
      [ "$ip" = "$bind" ] && continue
      is_ipv4 "$ip" || continue
      printf '%s\n' "$ip"
    done
    return 0
  fi
  local_ipv4_addrs | while IFS= read -r ip; do
    [ -n "$ip" ] || continue
    [ "$ip" = "$bind" ] && continue
    printf '%s\n' "$ip"
  done
}

wait_for_addr() { # $1=ip
  local ip="$1" deadline
  # 回环地址一定在，没必要等（selftest / 单机调试会绑 127.0.0.1）
  case "$ip" in 127.*|::1|localhost) return 0 ;; esac
  # 没有 ip 命令就无从判断，不因此拒绝启动（真绑不上时端口等待会兜住）
  if ! command -v ip >/dev/null 2>&1; then
    log "WARN: 没有 ip 命令，跳过地址就绪检查（$ip）"
    return 0
  fi
  deadline=$(( $(now) + ADDR_TIMEOUT ))
  while :; do
    if ip -4 addr show 2>/dev/null | grep -qF "inet $ip/"; then
      return 0
    fi
    [ "$(now)" -ge "$deadline" ] && return 1
    sleep 2
  done
}

wait_for_port() { # $1=ip $2=port $3=timeout $4=pid
  local ip="$1" port="$2" deadline=$(( $(now) + ${3:-PORT_TIMEOUT} )) watch="${4:-}"
  while :; do
    if (exec 3<>"/dev/tcp/$ip/$port") 2>/dev/null; then
      return 0
    fi
    if [ -n "$watch" ] && ! kill -0 "$watch" 2>/dev/null; then
      return 1
    fi
    [ "$(now)" -ge "$deadline" ] && return 1
    sleep 1
  done
}

# ---------------------------------------------------------------- 运行时

find_node() {
  local c v
  # 0) 仅供 selftest / 排障：DSH_NODE 直接指定（跳过版本校验，别在正式环境用）
  if [ -n "${DSH_NODE:-}" ] && [ -x "$DSH_NODE" ]; then
    printf '%s' "$DSH_NODE"
    return 0
  fi
  # 1) bundled（v1 默认形态）
  if [ -x "$RUNTIME/node/bin/node" ]; then
    printf '%s' "$RUNTIME/node/bin/node"
    return 0
  fi
  # 2) fnOS 应用中心的 nodejs（走 /var/apps 软链，天然不依赖卷号）
  for c in /var/apps/nodejs_v24/target /var/apps/nodejs_v23/target \
           /vol*/@appcenter/nodejs_v24 /vol*/@appcenter/nodejs_v23; do
    [ -x "$c/bin/node" ] || continue
    v="$("$c/bin/node" -v 2>/dev/null | sed 's/^v//')"
    if ver_ge "$v" "24.9.0"; then
      printf '%s' "$c/bin/node"
      return 0
    fi
  done
  return 1
}

find_dsh_entry() {
  local pkg="$RUNTIME/app/node_modules/@deepseek-ai/dsh/package.json" rel
  [ -f "$pkg" ] || return 1
  rel="$("$NODE_BIN" -e '
    try {
      const p = require(process.argv[1]);
      let b = p.bin;
      if (typeof b === "string") b = { dsh: b };
      process.stdout.write((b && (b.dsh || Object.values(b)[0])) || "");
    } catch (e) { process.stdout.write(""); }
  ' "$pkg" 2>/dev/null)"
  [ -n "$rel" ] || return 1
  local entry
  entry="$(dirname "$pkg")/$rel"
  [ -f "$entry" ] || return 1
  printf '%s' "$entry"
}

detect_mode() {
  if [ -f "$RUNTIME/app/node_modules/@deepseek-ai/dsh/package.json" ]; then
    printf 'dsh'
  elif [ -f "$RUNTIME/stub/server.mjs" ]; then
    printf 'stub'
  else
    printf 'none'
  fi
}

# Office 技能能不能挂载：三个路径必须同时存在。
# 这里刻意"宁可不挂也不挂错"——skill-office 在收到不合法的 assetRoot/cli 时
# 会让插件注册失败，而失败的 fiber 会拖垮整个启动。也就是说：多挂一次导致
# 起不来，比少挂一次（用户看到"没有 Office 技能"）严重得多。
office_patch() {
  local assets cli
  [ -f "$OFFICE_PATCH" ] || { log "office: skip（补丁文件缺失 $OFFICE_PATCH）"; return 1; }
  assets="$RUNTIME/app/node_modules/@deepseek-ai/dsh-skill-office/assets"
  [ -d "$assets" ] || { log "office: skip（技能资产缺失 $assets）"; return 1; }
  # 不写死 lib/cli.js：Kit 的子路径可能变，交给 node 的解析器按安装树找。
  cli="$("$NODE_BIN" -e '
    const { createRequire } = require("node:module");
    const { dirname, join } = require("node:path");
    try {
      const req = createRequire(process.argv[1] + "/package.json");
      process.stdout.write(join(dirname(req.resolve("@deepseek-ai/libreoffice-kit/package.json")), "lib", "cli.js"));
    } catch (e) { process.stdout.write(""); }
  ' "$RUNTIME/app" 2>/dev/null)"
  [ -n "$cli" ] && [ -f "$cli" ] || { log "office: skip（找不到 LibreOffice Kit 的 CLI）"; return 1; }
  export DSH_OFFICE_ASSETS="$assets" DSH_OFFICE_CLI="$cli" DSH_OFFICE_NODE="$NODE_BIN"
  log "office: enabled assets=$assets cli=$cli"
  return 0
}

resolve_workspace() {
  local p first
  first="${TRIM_DATA_SHARE_PATHS:-}"
  p="${first%%:*}"
  if [ -n "$p" ] && [ -d "$p" ]; then printf '%s' "$p"; return 0; fi
  # 回退：应用中心会给出 TRIM_DATA_SHARE_PATHS，手工调用时没有。
  # 实测安装后共享目录落在 $ROOT/shares/workspace（复数），
  # 单数 share/ 是早期猜测，留作兼容。
  for p in "$SELF_DIR/../shares/workspace" "$SELF_DIR/../share/workspace" \
           "/var/apps/$APPNAME/shares/workspace" "/var/apps/$APPNAME/share/workspace"; do
    [ -d "$p" ] && { printf '%s' "$p"; return 0; }
  done
  printf '%s' "$DSH_HOME"
}

# ---------------------------------------------------------------- 默认工作区
#
# 背景（docs/ISSUES.md F22）：dsh 的默认工作区路径是
#   <系统文档目录>/deepseek-harness/default-workspace
# linux 上「系统文档目录」由 `xdg-user-dir DOCUMENTS` 解析，而它只读
# $HOME/.config/user-dirs.dirs。这个文件不存在时，xdg-user-dir 会原样回显
# $HOME（我们真机实测：输出 /vol1/.../workspace/.dsh-home），dsh 又把
# 「文档目录 == HOME」判为不可用并抛 system Documents directory is unavailable，
# 于是首启的 initializeDefault 失败，前端只剩一句「无法创建默认工作区」。
# 修法：启动前把 user-dirs.dirs 写好，让 dsh 自己的逻辑能跑通。

docs_base() {
  local p
  p="$(resolve_workspace)"
  if [ "$p" = "$DSH_HOME" ]; then
    # 共享目录不可用：退成 HOME 的兄弟目录。绝不能让文档目录等于 HOME，
    # 那正是 dsh 判为「不可用」的条件。
    dirname "$DSH_HOME"
  else
    printf '%s' "$p"
  fi
}

own_by_app() { # $@=路径（不递归，只改我们自己创建的那几项）
  [ "$(id -u)" = "0" ] || return 0
  [ -n "${DSH_USER:-}" ] || return 0
  local p
  for p in "$@"; do
    [ -e "$p" ] || continue
    chown "$DSH_USER:$DSH_GROUP" "$p" 2>/dev/null \
      || log "WARN: chown $p 失败（dsh 可能写不进去）"
  done
  return 0
}

ensure_documents_dir() {
  local base cfgdir harness wsdir current
  base="$(docs_base)"
  if [ -z "$base" ]; then
    log "WARN: 无法确定文档目录，默认工作区可能建不出来"
    return 0
  fi
  cfgdir="$DSH_HOME/.config"
  harness="$base/deepseek-harness"
  wsdir="$harness/default-workspace"

  if ! mkdir -p "$cfgdir" 2>/dev/null; then
    log "WARN: 无法创建 $cfgdir，默认工作区可能建不出来"
    return 0
  fi

  current=""
  if [ -f "$DOCS_FILE" ]; then
    current="$(grep -E '^XDG_DOCUMENTS_DIR=' "$DOCS_FILE" 2>/dev/null \
               | tail -n1 | cut -d= -f2- | tr -d '"\r')"
  fi
  if [ "$current" != "$base" ]; then
    if {
      printf '# 由 dsh fpk 生成：给 dsh 一个可用的「文档目录」。\n'
      printf '# 删掉它，xdg-user-dir 会退回 $HOME，dsh 判定文档目录不可用，\n'
      printf '# 首启就建不出默认工作区（docs/ISSUES.md F22）。\n'
      printf 'XDG_DOCUMENTS_DIR="%s"\n' "$base"
    } >"$DOCS_FILE" 2>/dev/null; then
      chmod 600 "$DOCS_FILE" 2>/dev/null
      own_by_app "$cfgdir" "$DOCS_FILE"
      log "docs: XDG_DOCUMENTS_DIR=$base"
    else
      log "WARN: 无法写入 $DOCS_FILE，默认工作区可能建不出来"
      return 0
    fi
  fi

  if mkdir -p "$wsdir" 2>/dev/null; then
    own_by_app "$harness" "$wsdir"
    DSH_DEFAULT_WS="$wsdir"
    log "docs: base=$base default_ws=$wsdir"
  else
    log "WARN: 无法创建默认工作区目录 $wsdir"
  fi
  return 0
}

# dsh 只在「注册表 + 会话历史双空」时自动创建默认工作区，错过就不再创建
# （dsh-workspace/lib/index.js 的 initializeDefault 守卫）。老用户升级时注册表
# 必然非空，只能由我们补登记。必须在没有 dsh 进程在跑的时候改，否则会被内存
# 里的状态覆盖 —— do_start 走到这里时已经过了 is_running 的早退，满足条件。
ensure_default_workspace() {
  local wsjson helper out
  wsjson="$DSH_HOME/storages/workspace.json"
  if [ -z "$DSH_DEFAULT_WS" ]; then
    log "default-ws: 没有可用的默认工作区目录，跳过"
    return 0
  fi
  if [ ! -f "$wsjson" ]; then
    log "default-ws: 尚无注册表，留给 dsh 首启自建"
    return 0
  fi
  helper="$SELF_DIR/ensure-default-workspace.mjs"
  if [ ! -f "$helper" ]; then
    log "WARN: 缺少 $helper，跳过默认工作区登记"
    return 0
  fi
  if [ -z "${NODE_BIN:-}" ] || [ ! -x "$NODE_BIN" ]; then
    log "WARN: 没有可用的 node，跳过默认工作区登记"
    return 0
  fi

  out="$("$NODE_BIN" "$helper" --registry "$wsjson" --dir "$DSH_DEFAULT_WS" 2>&1)"
  log "default-ws: ${out:-（无输出）}"
  case "$out" in
    created*|defaulted*)
      chmod 600 "$wsjson" 2>/dev/null
      own_by_app "$wsjson" "${wsjson}.bak"
      ;;
  esac
  return 0
}

# ---------------------------------------------------------------- 授权目录
#
# 用户可以在「应用设置 → 访问权限」里把任意文件夹授权给本应用：平台把 ACL 授予
# 应用用户，并把路径用 TRIM_DATA_ACCESSIBLE_PATHS（冒号分隔）传给生命周期脚本。
# dsh 的目录选择器在非回环绑定下必定走 browse 后端
# （dsh-host-directory-picker-browse：按进程权限列举全盘、从家目录起步、带 / 面包屑），
# 所以只要 ACL 到位，用户在「+ 添加工作区」里就能一路点到那个文件夹。
#
# 这里只做记录与可读性探测，不改任何权限。日志有 auth-paths: 前缀，
# 排错时能区分四种情况：没授权（无这条）／平台没传进来（有「无」但用户说授了）／
# ACL 没落到 dsh（「进不去」）／目录能进但里面的文件读不了（「读不了」）。
#
# 探测必须以**应用用户的身份**做：root 有 CAP_DAC_OVERRIDE，会绕过 mode 位。
# 真机上就撞到过这个假阳性 —— 目录是 nobody:nogroup 0000、只靠 ACL 授给真正的
# 用户，root 探出来是「读写」，dsh 进去却一个文件都读不了（ISSUES F25）。
_PROBE_WARNED=0
probe_as_app() { # $1=test 选项（-r/-w/-x） $2=路径；退出码即结论
  if [ "$(id -u)" = "0" ] && [ -n "${DSH_USER:-}" ] && [ "$DSH_USER" != "root" ] \
     && id -u "$DSH_USER" >/dev/null 2>&1; then
    # 126/127 是「runuser/su 自己没起来」而不是「文件不可读」，那种情况换下一个办法，
    # 别把它当成权限结论 —— 否则日志会说「进不去」，而真正的原因是工具缺失。
    if command -v runuser >/dev/null 2>&1; then
      runuser -u "$DSH_USER" -- /bin/sh -c "test $1 \"\$1\"" sh "$2" 2>/dev/null
      case $? in
        126|127) : ;;
        *) return $? ;;
      esac
    fi
    if command -v su >/dev/null 2>&1; then
      su -s /bin/sh -c "test $1 \"\$1\"" "$DSH_USER" sh "$2" 2>/dev/null
      case $? in
        126|127) : ;;
        *) return $? ;;
      esac
    fi
    if [ "$_PROBE_WARNED" = "0" ]; then
      _PROBE_WARNED=1
      log "WARN: 没有可用的 runuser/su，无法以 $DSH_USER 身份探测权限（下面的可读写按 root 算，可能偏乐观）"
    fi
  fi
  test "$1" "$2"
}

# 抽查目录里前几条，看应用用户读不读得了。输出 "<读不了数> <抽查数> <首个样本>"
# 为什么要抽：目录本身可进、里面的文件却全是 0000 时，dsh 的会话里会报一堆
# 「无法读取」，用户看到的是 agent 在犯傻，实际是这批文件的属主/权限没给 dsh。
sample_unreadable() { # $1=目录 $2=最多看几条
  local dir="$1" cap="$2" n=0 bad=0 first="" f
  while IFS= read -r -d '' f; do
    n=$((n + 1))
    if ! probe_as_app -r "$f"; then
      bad=$((bad + 1))
      [ -n "$first" ] || first="$(basename "$f")（$(stat -c '%U:%G %a' "$f" 2>/dev/null)）"
    fi
    [ "$n" -ge "$cap" ] && break
  done < <(find "$dir" -mindepth 1 -maxdepth 1 -print0 2>/dev/null)
  printf '%s %s %s' "$bad" "$n" "$first"
}

log_accessible_paths() {
  local raw="${TRIM_DATA_ACCESSIBLE_PATHS:-}" p n=0 bad tot ex
  if [ -z "$raw" ]; then
    log "auth-paths: 无（用户未在「访问权限」里授权任何文件夹，dsh 只能访问共享目录）"
    return 0
  fi
  local IFS=':'
  for p in $raw; do
    [ -n "$p" ] || continue
    n=$((n + 1))
    p="${p%/}"
    if [ ! -d "$p" ]; then
      log "auth-paths: $p （不存在）"
      continue
    fi
    if ! probe_as_app -r "$p" || ! probe_as_app -x "$p"; then
      log "auth-paths: $p （$DSH_USER 进不去；授权没落到应用用户，或上级目录挡住了）"
      continue
    fi
    # 目录能进不等于能用：里面的文件若没给 $DSH_USER 权限，dsh 照样读不了。
    # 显式给 IFS，不能沿用循环里的 ':'（否则三个字段会被并进第一个）。
    IFS=' ' read -r bad tot ex <<EOF
$(sample_unreadable "$p" 6)
EOF
    if [ "${bad:-0}" -gt 0 ]; then
      log "auth-paths: $p （目录可进，但抽查 $tot 项里有 $bad 项 $DSH_USER 读不了，如 $ex；当工作区用时 dsh 会报「无法读取」，要先把这批文件的属主/权限修好）"
    elif probe_as_app -w "$p"; then
      log "auth-paths: $p （读写）"
    else
      log "auth-paths: $p （只读，当工作区用时写文件会失败）"
    fi
  done
  log "auth-paths: 共 ${n} 条"
  return 0
}

# dsh 的「选择工作区目录」对话框只从 $HOME 起步（dsh-host-directory-picker-browse
# 的 list() 在 path 缺省时取 homedir()），而我们的 HOME 是 .dsh-home —— 一个隐藏的
# 应用数据目录。前端还会把「home 及以下」压缩成一个「主目录」面包屑
# （displayCrumbs），所以用户进了这个框就再也点不到「我的文件」，只能在右上角
# 铅笔图标里手打绝对路径。这是 F24。
#
# 这里把每个授权目录软链进 $HOME/可访问目录/，让它们直接出现在对话框首屏。
# 钉住几条：
#   * 只清软链，不碰真实文件 —— 这个目录虽然归我们管，但删东西必须可解释；
#   * 授权目录若包含 $DSH_HOME，跳过 —— 否则 可访问目录/xxx/.dsh-home/可访问目录
#     会形成无限递归（选择器会一直能往下点）；
#   * 被别的授权目录包含的路径不再单独建链（外层已经点得进去），减少重复条目；
#   * 链接名就是目录名：dsh 用「用户选中的那个路径的最后一段」当工作区标题，
#     名字取歪了，下拉框里就跟着歪；
#   * 工作区登记的是 realpath 之后的规范路径，所以软链不影响 dsh 的唯一性判据。
ACCESS_LINK_DIRNAME="可访问目录"

# pnpm 的 store 位置对齐（F30）。
#
# 背景：dsh 装插件走 `pnpm add`，而 pnpm 把依赖以硬链指向内容寻址 store。
# 0.2.0 之前 HOME 指向 @appshare/dsh，profile 的 node_modules 就链到
# @appshare/dsh/.pnpm-store；0.2.0 起 HOME 改成 .dsh-home，pnpm 便想换到
# .dsh-home/.local/share/pnpm/store —— 两处 store 不同 → ERR_PNPM_UNEXPECTED_STORE，
# 插件装不上，而且报错只说「store 不一致」，不告诉你怎么修。
#
# 修法不是「钉死一个路径」，而是**跟着已有 profile 走**：读它 node_modules/.modules.yaml
# 里记录的 storeDir，把同一个路径写进 pnpm 的全局配置。没有 profile 就什么都不写
# （新装的 profile 与当时的默认 store 天然自洽，硬钉反而会制造同样的冲突）。
#
# 配置写在 $HOME/.config/pnpm/rc，不写 .npmrc：后者 npm 也会读，等于凭空给它
# 加一个不认识的键（pnpm 的 view/add 内部会转发给 npm，见 F29）。
ensure_pnpm_store_dir() {
  local rc="$DSH_HOME/.config/pnpm/rc" f store="" cur=""

  if [ -f "$rc" ]; then
    cur="$(sed -n 's/^[[:space:]]*store-dir[[:space:]]*=[[:space:]]*//p' "$rc" 2>/dev/null | tail -n1)"
  fi
  if [ -n "$cur" ]; then
    log "pnpm-store: 沿用已有配置 $cur"
    return 0
  fi

  for f in "$DSH_HOME"/profiles/*/node_modules/.modules.yaml; do
    [ -f "$f" ] || continue
    store="$(sed -n 's/^storeDir:[[:space:]]*//p' "$f" 2>/dev/null | head -n1 | tr -d "\"'")"
    [ -n "$store" ] && break
    store=""
  done

  if [ -z "$store" ]; then
    log "pnpm-store: 无已装 profile，保持 pnpm 默认（$DSH_HOME/.local/share/pnpm/store）"
    return 0
  fi

  # pnpm 的 storeDir 末尾带布局版本目录（…/v10），而 store-dir 配置要的是**不带**它的
  # 父路径，否则会拼成 …/v10/v10。只削一个尾部 /v<数字>。
  case "$store" in
    */v[0-9]|*/v[0-9][0-9]) store="${store%/*}" ;;
  esac

  if mkdir -p "$DSH_HOME/.config/pnpm" 2>/dev/null \
     && printf 'store-dir=%s\n' "$store" >>"$rc" 2>/dev/null; then
    own_by_app "$DSH_HOME/.config" "$DSH_HOME/.config/pnpm" "$rc"
    log "pnpm-store: 对齐已有 profile → store-dir=$store（写入 $rc）"
  else
    log "WARN: 无法写入 $rc，插件安装可能报 ERR_PNPM_UNEXPECTED_STORE"
  fi
}

link_accessible_paths() {
  local raw="${TRIM_DATA_ACCESSIBLE_PATHS:-}" dir link p base name suffix created=0
  local -a cand keep
  dir="$DSH_HOME/$ACCESS_LINK_DIRNAME"
  if [ -z "$raw" ]; then
    # 平台没传（比如手动 appcenter-cli start）时不清空：清掉只会让用户突然点不到，
    # 而真正撤销授权后软链本身也进不去，无害。
    log "access-links: 无授权目录，保持现状"
    return 0
  fi
  if ! mkdir -p "$dir" 2>/dev/null; then
    log "WARN: 无法创建 $dir，授权目录在「选择工作区目录」里看不见"
    return 0
  fi
  for link in "$dir"/*; do
    [ -L "$link" ] && rm -f "$link" 2>/dev/null
  done

  local IFS=':'
  for p in $raw; do
    [ -n "$p" ] || continue
    p="${p%/}"
    if [ ! -d "$p" ]; then
      log "access-links: 跳过 $p（不是目录或不存在）"
      continue
    fi
    case "$DSH_HOME/" in
      "$p"/*)
        log "access-links: 跳过 $p（包含 dsh 数据目录，软链会递归）"
        continue
        ;;
    esac
    cand+=("$p")
  done
  IFS=$' \t\n'

  local other skip
  for p in "${cand[@]+"${cand[@]}"}"; do
    skip=0
    for other in "${cand[@]+"${cand[@]}"}"; do
      [ "$p" = "$other" ] && continue
      case "$p/" in
        "$other"/*)
          skip=1
          log "access-links: 合并 $p（已包含在 $other 里）"
          break
          ;;
      esac
    done
    [ "$skip" = "0" ] && keep+=("$p")
  done

  for p in "${keep[@]+"${keep[@]}"}"; do
    base="$(basename "$p")"
    [ -n "$base" ] || base="root"
    name="$base"
    suffix=2
    while [ -e "$dir/$name" ]; do
      name="$base-$suffix"
      suffix=$((suffix + 1))
      [ "$suffix" -gt 20 ] && break
    done
    # 决定「要挂」这件事单独记一行，与「挂成功没有」分开：
    # 建软链要特权，某些文件系统（以及开发机上的 Windows）建不了，但
    # 「该不该出现在首屏」这个判断仍然成立，排错时要能分别看到这两件事。
    log "access-links: 挂载 $name -> $p"
    if ln -s "$p" "$dir/$name" 2>/dev/null; then
      created=$((created + 1))
    else
      log "WARN: 无法创建软链 $dir/$name（选择器里将看不到 $p）"
    fi
  done
  chmod 700 "$dir" 2>/dev/null
  own_by_app "$dir"
  log "access-links: 共 $created 条，见「选择工作区目录」首屏的「$ACCESS_LINK_DIRNAME」"
  return 0
}

rotate_log() {
  [ -f "$LOGFILE" ] || return 0
  local sz
  sz="$(stat -c %s "$LOGFILE" 2>/dev/null || echo 0)"
  if [ "${sz:-0}" -gt 5242880 ]; then
    mv -f "$LOGFILE" "$LOGFILE.1" 2>/dev/null
  fi
}

# ---------------------------------------------------------------- 进程

read_pidf() { # $1=pidfile
  [ -f "$1" ] || return 1
  local pid pgid
  read -r pid pgid <"$1" 2>/dev/null || return 1
  case "${pid:-}" in ''|*[!0-9]*) return 1 ;; esac
  [ "$pid" -gt 1 ] || return 1
  printf '%s %s\n' "$pid" "${pgid:-$pid}"
}

is_runningf() { # $1=pidfile
  local pid pgid pair cmd p seen=1
  pair="$(read_pidf "$1")" || return 1
  read -r pid pgid <<<"$pair" || return 1
  kill -0 "$pid" 2>/dev/null || return 1
  cmd="$(tr '\0' ' ' <"/proc/$pid/cmdline" 2>/dev/null || true)"
  [ -n "$cmd" ] || return 1

  # PID 复用防护：cmdline 里必须出现我们的运行时路径。
  #
  # 但同一个目录有两种写法，必须都认：
  #   ${TRIM_APPDEST}  = /vol1/@appcenter/dsh   ← 应用中心调用时
  #   $SELF_DIR/../target = /var/apps/dsh/target ← 手工/脚本调用时（软链）
  # 只比一种写法 → 进程明明在跑，status 却返回 3。2026-10-27 真机实测踩到：
  # start 由应用中心触发（记的是 /vol1/... 的 cmdline），而 05-verify 手工
  # 调 status（算的是 /var/apps/...），校验失败被误判成「未运行」。
  # 后果不是日志难看：status=3 会让应用中心以为没起来，可能重复 start / 拒绝 stop。
  for p in "$RUNTIME" "$APPDEST" \
           "$(readlink -f "$RUNTIME" 2>/dev/null)" \
           "$(readlink -f "$APPDEST" 2>/dev/null)"; do
    [ -n "${p:-}" ] || continue
    case "$cmd" in *"$p"*) seen=0; break ;; esac
  done
  return "$seen"
}

is_running() { is_runningf "$PIDFILE"; }

# 后台拉起一个进程并记下 pid/pgid。
# 为什么不让 setsid 直接跑 node：`setsid node &` 拿到的 $! 有时是 setsid 自己的
# pid（它先 fork 再 exec），那个进程转瞬即逝，pidfile 会记到死 pid → status 永远 3。
# 做法：让新会话里的 bash 自报 $$ 再 exec，pid 全程不变，且它就是进程组首进程。
SPAWN_PID=""
spawn_bg() { # $1=pidfile 其余=要执行的命令
  local pf="$1"; shift
  local pidtmp="$pf.tmp" launcher pid pgid no_setsid=0
  rm -f "$pidtmp" 2>/dev/null

  if command -v setsid >/dev/null 2>&1; then
    setsid bash -c 'echo $$ > "$1"; shift; exec "$@"' _ "$pidtmp" "$@" >>"$LOGFILE" 2>&1 &
    launcher=$!
  else
    # 没有 setsid 就没有独立进程组，stop 只能单进程杀（pty 子进程可能残留）
    bash -c 'echo $$ > "$1"; shift; exec "$@"' _ "$pidtmp" "$@" >>"$LOGFILE" 2>&1 &
    launcher=$!
    no_setsid=1
    log "WARN: setsid 不可用，进程组回收能力受限"
  fi

  local i=0
  while [ "$i" -lt 50 ]; do
    if [ -s "$pidtmp" ]; then pid="$(cat "$pidtmp" 2>/dev/null)"; break; fi
    sleep 0.1
    i=$((i + 1))
  done
  case "${pid:-}" in ''|*[!0-9]*) pid="$launcher" ;; esac
  rm -f "$pidtmp" 2>/dev/null

  # 有 setsid 才记录独立 pgid；否则记自身 pid，避免 stop 时误杀调用者的进程组
  if [ "$no_setsid" = "1" ]; then
    pgid="$pid"
  else
    pgid="$(ps -o pgid= -p "$pid" 2>/dev/null | tr -d ' ')"
    case "${pgid:-}" in ''|*[!0-9]*) pgid="$pid" ;; esac
  fi
  printf '%s %s\n' "$pid" "$pgid" >"$pf"
  chmod 600 "$pf" 2>/dev/null
  SPAWN_PID="$pid"
}

# kill -0 对僵尸进程也返回成功。stop 的收尾判定必须排除僵尸，
# 否则「进程已退出但还没被回收」会被误报成「没杀掉」。
is_alive() { # $1=pid
  kill -0 "$1" 2>/dev/null || return 1
  local st
  st="$(awk '{print $3}' "/proc/$1/stat" 2>/dev/null)"
  [ "${st:-}" = "Z" ] && return 1
  return 0
}

do_stopf() { # $1=pidfile $2=label
  local pf="$1" label="${2:-proc}" pid pgid pair
  if ! pair="$(read_pidf "$pf")"; then
    rm -f "$pf" 2>/dev/null
    log "stop($label): no pidfile, nothing to do"
    return 0
  fi
  read -r pid pgid <<<"$pair" || { rm -f "$pf" 2>/dev/null; return 0; }
  case "${pgid:-}" in ''|*[!0-9]*) pgid="$pid" ;; esac
  [ "$pgid" -gt 1 ] 2>/dev/null || pgid="$pid"

  # 绝不误杀自己所在的进程组
  local mypgid
  mypgid="$(ps -o pgid= -p $$ 2>/dev/null | tr -d ' ')"
  if [ -n "$mypgid" ] && [ "$pgid" = "$mypgid" ]; then
    log "stop($label): refuse to kill own process group ($pgid)"
    rm -f "$pf" 2>/dev/null
    return 0
  fi

  if kill -0 "$pid" 2>/dev/null; then
    log "stop($label): TERM pid=$pid pgid=$pgid"
    kill -TERM -- "-$pgid" 2>/dev/null || kill -TERM "$pid" 2>/dev/null
    local deadline=$(( $(now) + STOP_TIMEOUT ))
    while kill -0 "$pid" 2>/dev/null && [ "$(now)" -lt "$deadline" ]; do sleep 0.5; done
    if kill -0 "$pid" 2>/dev/null; then
      log "stop($label): TERM timeout, KILL group $pgid"
      kill -KILL -- "-$pgid" 2>/dev/null || kill -KILL "$pid" 2>/dev/null
      sleep 0.5
    fi
  fi

  # 权限不足时 kill 是静默失败（应用用户杀不掉 root 起的进程）。
  # 以前这里照样删 pidfile、回 0、报 done：平台以为停了，start 时端口还占着，
  # 只丢回来一个 10330，信息量为零（2026-10-27 真机踩到）。
  if is_alive "$pid"; then
    local who
    who="$(tr '\0' ' ' <"/proc/$pid/cmdline" 2>/dev/null | cut -c1-160)"
    log "stop($label): FAILED pid=$pid still alive user=$(id -un) cmd=$who"
    say "$(printf '停止失败：%s（pid %s）仍在运行，当前身份 %s 没有权限结束它。\n先用启动它的身份停掉（例如 root 下 kill %s），再重新启动应用。' \
      "$label" "$pid" "$(id -un)" "$pid")"
    return 1
  fi

  rm -f "$pf" 2>/dev/null
  log "stop($label): done"
  return 0
}

# ---------------------------------------------------------------- 入口跳转器

# 入口跳转器：$1=监听地址（可能是 0.0.0.0） $2=绑定地址（用于探测与回退） $3=允许跳转的地址列表
start_launcher() {
  local listen="$1" bind="$2" allow="${3:-}" lpid t
  [ -f "$LAUNCHER_ENTRY" ] || die "缺少入口跳转器：$LAUNCHER_ENTRY（请重新安装应用）"
  local -a extra=()
  [ -n "$allow" ] && extra=(--allow "$allow")
  spawn_bg "$LAUNCHER_PIDFILE" "$NODE_BIN" "$LAUNCHER_ENTRY" \
    --host "$listen" --port "$DSH_PORT" --state "$STATEFILE" --auth "${DSH_ENTRY:-auto}" "${extra[@]}"
  lpid="$SPAWN_PID"
  if ! wait_for_port "$bind" "$DSH_PORT" "$PORT_TIMEOUT" "$lpid"; then
    t="$(tail -n 10 "$LOGFILE" 2>/dev/null)"
    do_stopf "$LAUNCHER_PIDFILE" launcher
    say "$(printf '入口跳转器启动失败（端口 %s 未就绪）。最近的日志：\n%s' "$DSH_PORT" "$t")"
    exit 1
  fi
  if ! kill -0 "$lpid" 2>/dev/null; then
    t="$(tail -n 10 "$LOGFILE" 2>/dev/null)"
    do_stopf "$LAUNCHER_PIDFILE" launcher
    say "$(printf '入口跳转器启动后立即退出（端口 %s 可能被占用）。最近的日志：\n%s' "$DSH_PORT" "$t")"
    exit 1
  fi
  log "start: launcher pid=$lpid on $listen:$DSH_PORT (redirect base $bind, allow ${allow:-none})"
}

# TCP 中继：把非绑定地址上的 dsh 端口原样转到绑定地址。
# 不阻塞启动、失败只告警：那张网卡进了门而主地址可用，比整个应用起不来好。
# 参数：$1=bind $2=dsh_port 其余=需要接住的地址
start_relay() {
  local bind="$1" port="$2"; shift 2
  [ "$#" -gt 0 ] || return 0
  if [ ! -f "$RELAY_ENTRY" ]; then
    log "WARN: 缺少 relay：$RELAY_ENTRY（多网卡地址不可用，仅 $bind 可访问）"
    return 0
  fi
  if is_runningf "$RELAY_PIDFILE"; then
    log "start: relay already running"
    return 0
  fi

  local ip spec=""
  for ip in "$@"; do spec="${spec:+$spec,}$ip:$port"; done
  spawn_bg "$RELAY_PIDFILE" "$NODE_BIN" "$RELAY_ENTRY" --listen "$spec" --target "$bind:$port"
  local rpid="$SPAWN_PID"

  # 只做一次存活确认，不等端口：某个地址绑不上（比如接口刚 down）不该拖住启动，
  # 真失败会写进 info.log（relay: listen ... failed）。
  sleep 1
  if kill -0 "$rpid" 2>/dev/null; then
    log "start: relay pid=$rpid listen $spec -> $bind:$port"
  else
    log "WARN: relay 启动后立即退出（listen $spec），这些地址将不可访问"
    do_stopf "$RELAY_PIDFILE" relay
  fi
  return 0
}

# 跳转器从 state 文件读「这一轮的入口 URL」。dsh 每次启动都会换 token，
# 所以 dsh 起来之后必须立刻刷新这个文件，否则用户点图标会被送到旧 token。
#
# token 单独存一份（而不是只存 url）：url 里 dsh 打的主机名可能是 127.0.0.1，
# 跳转器必须用「绑定 IP + 内部端口」重建地址，只有 token 是真正需要传下去的。
write_state() { # $1=bind
  local url="" tok=""
  [ -s "$URLFILE" ] && url="$(head -n1 "$URLFILE" 2>/dev/null)"
  [ -n "$url" ] || url="http://$1:$INTERNAL_PORT/"
  # token 的字符集不要写死成 [A-Za-z0-9_-]：上游可能换成带 "." / "+" / "="
  # 的 opaque 串，写死会把 token 截断，表现为「跳转 302 了但点进去 401」，
  # 而日志里的 token 已打码，很难看出是被截断。这里只排除分隔符与空白。
  tok="$(printf '%s' "$url" | grep -oE 'token=[^&"[:space:]]+' | head -n1 | cut -d= -f2-)"
  printf '{"url":"%s","token":"%s","host":"%s","port":%s,"since":%s}\n' \
    "$url" "$tok" "$1" "$INTERNAL_PORT" "$(now)" >"$STATEFILE"
  chmod 600 "$STATEFILE" 2>/dev/null
}

do_start() {
  load_settings

  MODE="$(detect_mode)"
  [ "$MODE" = "none" ] && die "运行时缺失：$RUNTIME 下既没有 dsh，也没有 stub。请重新安装应用。"

  NODE_BIN="$(find_node)" || die "未找到可用的 Node 运行时（需要 >= 24.9）。请重新安装应用，或在应用中心安装 Node.js v24。"
  export NODE_BIN

  # dsh 的插件管理全部转发给 pnpm（`pnpm view` / `pnpm add`），而且是 spawn 裸命令名，
  # 只认 PATH。我们的运行时只拷了 node 二进制（没有 npm/npx），系统 PATH 里也没有
  # pnpm → Web 界面「添加插件」一律报 `spawn pnpm ENOENT`，与包名无关（F28）。
  # build.sh 把 pnpm 装在 runtime/pnpm，并在 runtime/node/bin 放同名 wrapper；
  # 前置这个目录一次解决两件事：pnpm 可见；pnpm 用自带 node 跑，而不是系统 v22。
  if [ -x "$RUNTIME/node/bin/pnpm" ]; then
    export PATH="$RUNTIME/node/bin:$PATH"
    local pnpm_ver=""
    # 用 node 解析而不是 sed/grep 抓行：package.json 可能是压缩成一行发布的，
    # 「按行首匹配 "version"」会静默取空，日志里就成了「未知」，排错时误导方向。
    pnpm_ver="$("$NODE_BIN" -e 'try{process.stdout.write(String(JSON.parse(require("fs").readFileSync(process.argv[1],"utf8")).version||""))}catch(e){}' \
      "$RUNTIME/pnpm/node_modules/pnpm/package.json" 2>/dev/null || true)"
    log "start: pnpm=$RUNTIME/node/bin/pnpm version=${pnpm_ver:-未知}（已前置到 PATH）"

    # pnpm 的 `view` / `config` 会 spawn 裸命令 "npm" 转发（F29）。只前置 pnpm 而不带
    # npm 时，这个 npm 会命中系统那份（飞牛自带 10.9.3），被自带 node 24 跑起来就崩在
    # minizlib，界面显示成「无法获取插件信息：npm error Class extends value undefined」。
    if [ -x "$RUNTIME/node/bin/npm" ]; then
      local npm_ver=""
      npm_ver="$("$NODE_BIN" -e 'try{process.stdout.write(String(JSON.parse(require("fs").readFileSync(process.argv[1],"utf8")).version||""))}catch(e){}' \
        "$RUNTIME/npm/node_modules/npm/package.json" 2>/dev/null || true)"
      log "start: npm=$RUNTIME/node/bin/npm version=${npm_ver:-未知}（pnpm 的 view/add 转发目标）"
    else
      log "WARN: 缺少 runtime/node/bin/npm —— pnpm 的 view/add 会转发给系统 npm，与自带 node 不兼容（需 0.7.0+ 的完整包）"
    fi
  else
    log "WARN: 缺少 runtime/node/bin/pnpm —— dsh 里装插件会报 spawn pnpm ENOENT（需 0.7.0+ 的完整包）"
  fi

  local bind
  bind="$(resolve_bind "${DSH_BIND:-auto}")"
  [ -n "$bind" ] || die "无法探测监听地址。请在应用设置里手动指定本机的一个局域网 IP。"
  is_ipv4 "$bind" || die "监听地址不合法：$bind"
  [ "$bind" = "0.0.0.0" ] && die "dsh 不接受 0.0.0.0，请填写具体网卡地址（例如 192.168.1.10）。"

  wait_for_addr "$bind" || die "等待地址 $bind 超时（${ADDR_TIMEOUT}s）。可能是网络尚未就绪，请稍后重试，或在应用设置里改为其它地址。"

  # ---- 多网卡 ----
  # dsh 只能绑一个地址（通配在 load 阶段被拒），所以其余本机地址要靠 relay 接住，
  # 并登记进 --trusted-host 让它的 Host/Origin 栅栏放行。详见
  # docs/HARNESS-ARCHITECTURE.md §5 / §9。
  #
  # 只有真的存在第二个地址时才把跳转器改成 0.0.0.0：单网卡机器保持旧行为，
  # 不额外暴露在 docker0 这类接口上。
  local -a relay_ips=()
  local _ip launcher_listen="$bind" allow_list="$bind"
  for _ip in $(other_ipv4_addrs "$bind"); do relay_ips+=("$_ip"); done
  if [ "${#relay_ips[@]}" -gt 0 ]; then
    launcher_listen="0.0.0.0"
    for _ip in "${relay_ips[@]}"; do allow_list="$allow_list,$_ip"; done
  fi

  # 端口分工：service_port（图标、checkport 用的那个）归跳转器，
  # dsh 退到 service_port+1。这样点图标进来的是跳转器，能自动带令牌。
  local dsh_port="$DSH_PORT"
  if [ "$MODE" = "dsh" ]; then
    INTERNAL_PORT=$((DSH_PORT + 1))
    if [ "$INTERNAL_PORT" -gt 65535 ]; then
      die "端口 $DSH_PORT 没有可用的内部端口（dsh 需要 $((DSH_PORT + 1))）。请在应用设置里改成 3080 之类的值。"
    fi
    dsh_port="$INTERNAL_PORT"
  fi

  # 已经在跑：两个进程都在 → 幂等返回；
  # dsh 在、跳转器掉了（崩溃/被杀）→ 只补起跳转器，不重启 dsh（那会打断会话）。
  if is_running; then
    if [ "$MODE" = "dsh" ] && ! is_runningf "$LAUNCHER_PIDFILE"; then
      log "start: dsh 在运行但跳转器不在，补起跳转器"
      start_launcher "$launcher_listen" "$bind" "$allow_list"
      write_state "$bind"
    fi
    if [ "$MODE" = "dsh" ] && [ "${#relay_ips[@]}" -gt 0 ]; then
      # 跳转器可能刚被补起，relay 也一样：只补缺的那部分，不重启 dsh（会打断会话）
      start_relay "$bind" "$dsh_port" "${relay_ips[@]}"
    fi
    log "start: already running"
    return 0
  fi

  # 共享目录可能被上一次卸载改成 000，建不出来就退回 @appdata（能跑，代价是升级丢会话）
  if ! mkdir -p "$DSH_HOME" 2>/dev/null; then
    log "WARN: 无法创建 $DSH_HOME，退回 $PKGVAR/dsh-home"
    DSH_HOME="$PKGVAR/dsh-home"
    mkdir -p "$DSH_HOME" 2>/dev/null || die "无法创建数据目录 $DSH_HOME"
  fi
  chmod 700 "$DSH_HOME" 2>/dev/null
  rotate_log

  # 必须在拉起 dsh 之前做完（F22）：
  #   1) 文档目录可解析 —— 否则 dsh 首启建不出默认工作区；
  #   2) 老用户补登记默认工作区 —— 注册表非空时 dsh 自己不会再建。
  # 这里已经过了 is_running 的早退，确定没有 dsh 进程在跑，改注册表才安全。
  ensure_documents_dir
  ensure_default_workspace
  # pnpm 的 store 必须和已装 profile 对齐，否则「添加插件」一律 ERR_PNPM_UNEXPECTED_STORE（F30）。
  # 只读 profile 元数据 + 可能写一行配置，幂等，放心每次启动都跑。
  ensure_pnpm_store_dir
  # 用户在「访问权限」里授权过的文件夹（F23）：记录 + 探测可读性，
  # 并把它们软链进 HOME，否则「选择工作区目录」里根本走不到（F24）。
  log_accessible_paths
  link_accessible_paths

  # 记下当前日志长度：抓 token 时只看本次启动新增的部分。
  # 否则 grep 整个日志会命中上一次的 URL —— 那个 token 早已随旧进程失效。
  local logoff=0
  [ -f "$LOGFILE" ] && logoff="$(stat -c %s "$LOGFILE" 2>/dev/null || echo 0)"
  case "${logoff:-}" in ''|*[!0-9]*) logoff=0 ;; esac

  local workdir
  workdir="$(resolve_workspace)"
  cd "$workdir" 2>/dev/null || cd "$PKGVAR" || die "无法进入工作目录"
  log "start: cwd=$workdir node=$NODE_BIN bind=$bind dsh_port=$dsh_port home=$DSH_HOME entry=${DSH_ENTRY:-auto} relay=${relay_ips[*]:-none}"

  local entry
  local -a cmd trusted=() patchargs=()
  if [ "$MODE" = "dsh" ]; then
    entry="$(find_dsh_entry)" || die "运行时损坏：找不到 dsh 的入口文件。"
    # 每个被 relay 接住的地址都要进 trustedHosts：Host 栅栏只认 loopback、
    # 绑定 IP、以及 --trusted-host 列出的 authority（见 HARNESS-ARCHITECTURE §5.3）。
    # 取值必须是「裸 authority」——带路径会让插件 load 失败，进程秒退。
    for _ip in "${relay_ips[@]}"; do trusted+=(--trusted-host "$_ip:$dsh_port"); done
    # Office 技能是可选增强：office_patch 自己会把三条路径逐个验过，
    # 任一不满足就返回 1，此时命令行与 0.8.0 完全一致（不传 --patch）。
    if office_patch; then patchargs=(--patch "$OFFICE_PATCH"); fi
    cmd=("$entry" --profile web "${patchargs[@]}" --host "$bind" --port "$dsh_port" --no-open "${trusted[@]}")
    export DSH_HOME
    # dsh 会往 HOME 下写缓存/凭据，不设就可能落到 /root 或应用用户的默认家目录（不可写）
    export HOME="$DSH_HOME"
    # xdg-user-dir 读 $XDG_CONFIG_HOME/user-dirs.dirs，不设就用 ~/.config。
    # 这里钉死，保证它读到的就是我们写的那份（外部环境若设了别的值会让我们白写）。
    export XDG_CONFIG_HOME="$DSH_HOME/.config"
    if [ -n "${DSH_API_KEY:-}" ]; then export DEEPSEEK_API_KEY="$DSH_API_KEY"; fi
    # Node 24 的 V8 字节码缓存：dsh 冷启动要加载几千个模块，逐次解析编译
    # 占掉启动耗时的大头。设了之后首次启动写缓存，之后每次 start 都命中
    # （0.9.2 性能优化，见 DEVLOG 37.9）。目录放 @appdata：随卸载消失、
    # 应用用户可写，坏了删掉就自动重建，无需任何维护。
    export NODE_COMPILE_CACHE="$PKGVAR/compile-cache"
    log "start: mode=dsh entry=$entry"
    # 跳转器先起：它占着 service_port，端口冲突要在这一步就暴露，
    # 而不是等 dsh 起来后用户点图标才发现打不开。
    rm -f "$STATEFILE" 2>/dev/null
    start_launcher "$launcher_listen" "$bind" "$allow_list"
  else
    entry="$RUNTIME/stub/server.mjs"
    cmd=("$entry" --host "$bind" --port "$dsh_port")
    log "start: mode=stub entry=$entry"
  fi

  local pid pgid
  spawn_bg "$PIDFILE" "$NODE_BIN" "${cmd[@]}"
  pid="$SPAWN_PID"
  read -r _ pgid <"$PIDFILE" 2>/dev/null || pgid="$pid"

  if ! wait_for_port "$bind" "$dsh_port" "$PORT_TIMEOUT" "$pid"; then
    log "start: port not ready, aborting"
    local tail_log
    tail_log="$(tail -n 15 "$LOGFILE" 2>/dev/null)"
    do_stop
    say "$(printf '应用启动失败（端口 %s 未就绪）。最近的日志：\n%s' "$dsh_port" "$tail_log")"
    exit 1
  fi

  # 端口通了不代表我们起来了：端口可能本来就被别的进程（或上次没杀干净的实例）占着，
  # 而新进程一启动就 EADDRINUSE 退出。这里必须确认记录的那个 pid 还活着。
  if ! kill -0 "$pid" 2>/dev/null; then
    local who tail_log
    who="$(ss -ltnp 2>/dev/null | grep -E ":${dsh_port}[[:space:]]" | head -n1)"
    tail_log="$(tail -n 15 "$LOGFILE" 2>/dev/null)"
    do_stop
    say "$(printf '应用启动失败：进程启动后立即退出（端口 %s 可能已被占用）。\n占用者：%s\n若占用者是别人（例如 root 下手工启动过）留下的，先用那个身份停掉它，\n否则应用中心只会给一个 10330，看不出原因。\n最近的日志：\n%s' "$dsh_port" "${who:-未知}" "$tail_log")"
    exit 1
  fi

  # 多网卡：dsh 已经在这个绑定地址上监听了，现在把其余地址接上。
  # 必须等 dsh 就绪后再起，否则 relay 会把早期连接全部打回（upstream error）。
  if [ "$MODE" = "dsh" ] && [ "${#relay_ips[@]}" -gt 0 ]; then
    start_relay "$bind" "$dsh_port" "${relay_ips[@]}"
  fi

  # dsh 只在日志里打印带 token 的入口 URL，抓出来存一份（600）
  if [ "$MODE" = "dsh" ]; then
    local url="" waited=0
    # 端口通了不等于日志已落盘（stdout 缓冲），最多再等 8 秒。
    # 这个 token 现在是「点图标即进」的唯一来源，早放弃等于入口打不开。
    while [ "$waited" -lt 80 ]; do
      url="$(tail -c +"$((logoff + 1))" "$LOGFILE" 2>/dev/null \
             | grep -oE 'https?://[^ "'"'"']*token=[^ "'"'"'&]+' | tail -n1)"
      [ -n "$url" ] && break
      sleep 0.1
      waited=$((waited + 1))
    done
    if [ -n "$url" ]; then
      printf '%s\n' "$url" >"$URLFILE"
      chmod 600 "$URLFILE" 2>/dev/null
      log "start: url=$(printf '%s' "$url" | sed -E 's/(token=)[A-Za-z0-9_-]+/\1***/')"
    else
      # 不致命：服务已起来，只是没抓到入口链接（dsh 可能改了输出格式）。
      # state 仍要写，但写的是不带令牌的裸地址 —— 跳转器会把用户送到 dsh 的 401 页，
      # 比停在「正在启动」的白屏更容易自查。
      log "WARN: 本次启动未从日志抓到 token URL，请在 $LOGFILE 里手工查找 token="
    fi
    write_state "$bind"
    # state 是 JSON：token 有两个位置，url 里是 `?token=`，顶层是 `"token":"…"`。
    # 以前只打第一种，于是每次启动都把完整令牌明文写进 info.log（实测 23 个
    # 唯一令牌），而 info.log 是用户会下载、发给我们排障的那份文件 —— 等于把
    # 当前可用的登录令牌一起发出去。两条规则都要有，且只留前 4 位便于对时。
    log "start: state=$(sed -E -e 's#(token=)[A-Za-z0-9_-]+#\1***#g' \
                             -e 's#("token": *")[A-Za-z0-9_-]+#\1***#g' \
                             "$STATEFILE" 2>/dev/null)"
  fi

  log "start: ok pid=$pid pgid=$pgid"
  return 0
}

do_stop() {
  local rc=0
  # 先停 relay：它只是转发，先关掉就不会在 dsh 退出过程中继续接新连接
  do_stopf "$RELAY_PIDFILE" relay || rc=1
  do_stopf "$PIDFILE" dsh || rc=1
  do_stopf "$LAUNCHER_PIDFILE" launcher || rc=1
  # 只在真的停干净后才清 state：留着 state 至少能让 healthz 说清楚「上次的有令牌地址」，
  # 而 pidfile 被误删 + state 被清 + 端口仍被占，是排查时最难受的组合。
  [ "$rc" -eq 0 ] && rm -f "$STATEFILE" 2>/dev/null
  return $rc
}

do_status() {
  # 只用 kill -0 + /proc 校验，不碰 HTTP、不读日志（要便宜）
  if ! is_running; then
    return 3
  fi
  # dsh 在跑但跳转器死了 = 点图标打不开，必须报「异常」而不是「运行中」，
  # 否则应用中心会认为一切正常，永远不会去修。
  if [ "$(detect_mode)" = "dsh" ] && ! is_runningf "$LAUNCHER_PIDFILE"; then
    return 1
  fi
  # relay 故意不参与判定：它只影响「非绑定地址」那张网卡，主地址仍可用。
  # 把它算成异常会让应用中心反复重启整个应用，反而打断正在跑的会话。
  return 0
}

# ---------------------------------------------------------------- 入口

case "${1:-}" in
  start)
    do_start
    exit 0
    ;;
  stop)
    do_stop
    exit $?
    ;;
  status)
    do_status
    exit $?
    ;;
  restart)
    do_stop
    do_start
    exit 0
    ;;
  url)
    # 只读：打印本次启动的入口令牌地址（给「配对这台设备」用）
    if [ -s "$URLFILE" ]; then
      head -n1 "$URLFILE"
      exit 0
    fi
    say "还没有入口地址：应用可能未启动，或本次启动没抓到 token。看看 $LOGFILE"
    exit 1
    ;;
  *)
    say "用法: $0 {start|stop|status|restart|url}"
    exit 1
    ;;
esac
