desc="DeepSeek 开源的 agent harness（dsh）。以本地 Web 界面提供 AI 编程智能体，支持工具调用、终端与文件操作，仅限局域网访问。"
source="thirdparty"
platform="x86"

maintainer="dsh-fnos"
maintainer_url="https://github.com/deepseek-ai"

os_min_version="1.0.0"

desktop_uidir="ui"
desktop_applaunchname="dsh.main"

ctl_stop="true"
checkport="true"
service_port="3080"
disable_authorization_path="true"

changelog="0.4.0：点图标即可进入。新增入口跳转器（service_port 归它，dsh 退到 3080+1），首次在新设备打开时粘贴一次入口令牌，之后 180 天内直接进入；令牌栅栏保留，未配对的设备只能看到粘贴页。同时修复启动后进程秒退却仍报成功的问题。"
